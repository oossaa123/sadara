# Export these variables in your shell or configure them in your hosting service.
# This file is a template; Django does not load it automatically.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required in production with DEBUG=False. Set a long random value.
SECRET_KEY=
# Optional independent signing key; defaults to SECRET_KEY.
JWT_SECRET=
# Optional isolated SQLite database for previews/tests.
# SADARA_DB_PATH=/tmp/sadara-preview.sqlite3
# For Railway persistent storage, use the actual attached volume mount path.
# SADARA_DB_PATH=/data/sadara.db
# SADARA_MEDIA_ROOT=/data/media
# Only needed to provision an administrator with: python manage.py seed_site
# SADARA_ADMIN_USERNAME=
# SADARA_ADMIN_PASSWORD=
# SADARA_ADMIN_NAME=مدير النظام
# Only needed when frontend and backend use different origins.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
